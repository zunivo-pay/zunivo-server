# ---------------------------------------------------------------------------
# ONE switch picks the chain, contracts, start blocks, explorer and x402 id.
#   mainnet → Arc mainnet (chainId 5042), v1.3 contracts, real USDC, zunivo-mainnet.db
#   testnet → Arc testnet (chainId 5042002), sandbox contracts, zunivo.db
# ---------------------------------------------------------------------------
NETWORK=mainnet

PORT=8787
APP_ORIGIN=https://app.zunivo.io          # CORS origin + payUrl base (testnet: https://testnet.zunivo.io)
API_BASE=https://api.zunivo.io            # canonical URL of THIS instance (testnet: https://testnet-api.zunivo.io)

# Dedicated RPC strongly recommended in production (public gateway rate-limits):
# RPC_URL=https://your-dedicated-arc-mainnet-rpc

# Optional overrides — normally NOT needed, the NETWORK defaults are correct:
# DB_PATH=zunivo-mainnet.db
# ROUTER_ADDRESS= SCHED_ADDRESS= NAMES_ADDRESS= SPLIT_ADDRESS= RECORDS_ADDRESS=
# START_BLOCK= SCHED_START_BLOCK= NAMES_START_BLOCK=

# Circle Agent Marketplace paid services: payout wallet for the x402 endpoints (0x…)
X402_DEMO_PAYTO=
# X402_DEMO_PRICE=0.05

# KEEPER_PK=0x...  # optional: enables auto-release of scheduled sends at unlock
